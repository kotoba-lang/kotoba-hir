(ns kotoba.form
  "A typed, recursive s-expression value for Kotoba source that walks compiler
  data (KIR/HIR forms, type descriptors, module maps).

  Kotoba's :document is bounded (depth 8, 32 items per container), and a
  compiler's data is not. A record that refers to itself through a `[:list
  [:ref q]]` field is unbounded in both, is a closed nominal type, and needs no
  host: this is that record. It is Kotoba-only (the host walks real Clojure
  data); a module that wants it requires it under `#?(:kotoba ...)` and declares
  the same `:form/r` schema, which is one type because schemas compare
  structurally.

  Tags: 0 nil, 1 bool (n is 0 or 1), 2 int (n), 3 string (s), 4 keyword (k),
  5 symbol (s), 6 list/seq, 7 vector, 8 set, 9 map (kids are k v k v ...)."
  {:kotoba/export [bool-form count-of eq first-of form-map form-seq form-set form-vec int-form
                   int-value is-bool? is-int? is-keyword? is-map? is-nil? is-seq? is-set?
                   is-string? is-symbol? is-vec? kids-of keyword-form keyword-value form-get
                   form-has? no-forms nth-of nil-form one-form string-form string-value
                   symbol-form symbol-value tag-of is-true? two-forms three-forms
                   append-form is-list-like? bool-value assoc-form rest-list last-of cons-onto call0 call1 call2 call3 call4 call5 call6 vec2 vec3 vec4 vec5 vec6 from-document keys-of keyword-has-namespace? dissoc-form append-many edn-form]}
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]]]]
            :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]}))

(defn no-forms [] [:list [:ref :form/r]]
  (typed-list-new [:list [:ref :form/r]]))

(defn one-form [a [:ref :form/r]] [:list [:ref :form/r]]
  (typed-list-new [:list [:ref :form/r]] a))

(defn two-forms [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
  (typed-list-new [:list [:ref :form/r]] a b))

(defn three-forms [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:list [:ref :form/r]]
  (typed-list-new [:list [:ref :form/r]] a b c))

(defn append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
  (typed-list-conj [:list [:ref :form/r]] xs x))

(defn- mk [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]]] [:ref :form/r]
  (record-new [:ref :form/r] t s n k kids))

(defn nil-form [] [:ref :form/r] (mk 0 "" 0 :none (no-forms)))
(defn bool-form [b :bool] [:ref :form/r] (mk 1 "" (if b 1 0) :none (no-forms)))
(defn int-form [n :i64] [:ref :form/r] (mk 2 "" n :none (no-forms)))
(defn string-form [s :string] [:ref :form/r] (mk 3 s 0 :none (no-forms)))
(defn keyword-form [k :keyword] [:ref :form/r] (mk 4 "" 0 k (no-forms)))
(defn symbol-form [s :string] [:ref :form/r] (mk 5 s 0 :none (no-forms)))
(defn form-seq [kids [:list [:ref :form/r]]] [:ref :form/r] (mk 6 "" 0 :none kids))
(defn form-vec [kids [:list [:ref :form/r]]] [:ref :form/r] (mk 7 "" 0 :none kids))
(defn form-set [kids [:list [:ref :form/r]]] [:ref :form/r] (mk 8 "" 0 :none kids))
(defn form-map [kids [:list [:ref :form/r]]] [:ref :form/r] (mk 9 "" 0 :none kids))

(defn tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag))
(defn kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids))
(defn int-value [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n))
(defn string-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s))
(defn symbol-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s))
(defn keyword-value [f [:ref :form/r]] :keyword (record-get [:ref :form/r] f :k))
(defn bool-value [f [:ref :form/r]] :bool (= 1 (record-get [:ref :form/r] f :n)))

(defn is-nil? [f [:ref :form/r]] :bool (= 0 (tag-of f)))
(defn is-bool? [f [:ref :form/r]] :bool (= 1 (tag-of f)))
(defn is-int? [f [:ref :form/r]] :bool (= 2 (tag-of f)))
(defn is-string? [f [:ref :form/r]] :bool (= 3 (tag-of f)))
(defn is-keyword? [f [:ref :form/r]] :bool (= 4 (tag-of f)))
(defn is-symbol? [f [:ref :form/r]] :bool (= 5 (tag-of f)))
(defn is-seq? [f [:ref :form/r]] :bool (= 6 (tag-of f)))
(defn is-vec? [f [:ref :form/r]] :bool (= 7 (tag-of f)))
(defn is-set? [f [:ref :form/r]] :bool (= 8 (tag-of f)))
(defn is-map? [f [:ref :form/r]] :bool (= 9 (tag-of f)))
(defn is-list-like? [f [:ref :form/r]] :bool (or (= 6 (tag-of f)) (= 7 (tag-of f))))
(defn is-true? [f [:ref :form/r]] :bool (and (= 1 (tag-of f)) (= 1 (record-get [:ref :form/r] f :n))))

(defn count-of [f [:ref :form/r]] :i64 (vector-count (kids-of f)))

(defn nth-of [f [:ref :form/r] i :i64] [:ref :form/r]
  (if (and (>= i 0) (< i (count-of f)))
    (typed-list-nth [:list [:ref :form/r]] (kids-of f) i)
    (nil-form)))

(defn first-of [f [:ref :form/r]] [:ref :form/r] (nth-of f 0))

(defn- lookup-from [kids [:list [:ref :form/r]] key [:ref :form/r] i :i64] [:ref :form/r]
  (let [n (vector-count kids)]
    (loop [j i]
      (if (>= (+ j 1) n)
        (nil-form)
        (if (eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
          (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
          (recur (+ j 2)))))))

(defn form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
  (lookup-from (kids-of m) key 0))

(defn- lookup-has [kids [:list [:ref :form/r]] key [:ref :form/r]] :bool
  (let [n (vector-count kids)]
    (loop [j 0]
      (if (>= (+ j 1) n)
        false
        (if (eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
          true
          (recur (+ j 2)))))))

(defn form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
  (lookup-has (kids-of m) key))

(defn- member? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
  (let [n (vector-count xs)]
    (loop [i 0]
      (if (>= i n) false
        (if (eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i)))))))

(defn- ordered-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
  (let [n (vector-count xs)]
    (if (= n (vector-count ys))
      (loop [i 0]
        (if (>= i n) true
          (if (eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys i))
            (recur (inc i))
            false)))
      false)))

(defn- set-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
  (let [n (vector-count xs)]
    (if (= n (vector-count ys))
      (loop [i 0]
        (if (>= i n) true
          (if (member? ys (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false)))
      false)))

(defn- map-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
  (let [n (vector-count xs)]
    (if (= n (vector-count ys))
      (loop [j 0]
        (if (>= (+ j 1) n) true
          (let [k (typed-list-nth [:list [:ref :form/r]] xs j)]
            (if (and (lookup-has ys k)
                     (eq (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)) (lookup-from ys k 0)))
              (recur (+ j 2))
              false))))
      false)))

(defn eq
  "Structural equality, as `=` on the host's data: a list and a vector are
  different kinds here (as are they to the reader), sets and maps compare
  without order."
  [a [:ref :form/r] b [:ref :form/r]] :bool
  (let [t (tag-of a)]
    (and (= t (tag-of b))
         (cond
           (= t 0) true
           (= t 1) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
           (= t 2) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
           (= t 3) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
           (= t 4) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
           (= t 5) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
           (= t 8) (set-eq (kids-of a) (kids-of b))
           (= t 9) (map-eq (kids-of a) (kids-of b))
           :else (ordered-eq (kids-of a) (kids-of b))))))

(defn rest-list
  "The kids of F after the first, as a list."
  [f [:ref :form/r]] [:list [:ref :form/r]]
  (let [xs (kids-of f)
        n (vector-count xs)]
    (loop [i 1 acc (no-forms)]
      (if (>= i n)
        acc
        (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i)))))))

(defn last-of [f [:ref :form/r]] [:ref :form/r]
  (nth-of f (dec (count-of f))))

(defn cons-onto [x [:ref :form/r] xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (let [n (vector-count xs)]
    (loop [i 0 acc (one-form x)]
      (if (>= i n)
        acc
        (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i)))))))

(defn assoc-form
  "Map M with K bound to V: the first entry whose key is K keeps its place and
  takes V, else K V are appended (as `assoc` on the host's map)."
  [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
  (let [xs (kids-of m)
        n (vector-count xs)]
    (if (lookup-has xs k)
      (form-map
       (loop [j 0 acc (no-forms)]
         (if (>= (+ j 1) n)
           acc
           (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
             (recur (+ j 2)
                    (typed-list-conj [:list [:ref :form/r]]
                                     (typed-list-conj [:list [:ref :form/r]] acc key)
                                     (if (eq key k) v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))
      (form-map (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] xs k) v)))))

;; Builders for the call forms a rewrite emits: (NAME a b ...) with NAME a symbol.
(defn call0 [name :string] [:ref :form/r] (form-seq (one-form (symbol-form name))))
(defn call1 [name :string a [:ref :form/r]] [:ref :form/r]
  (form-seq (two-forms (symbol-form name) a)))
(defn call2 [name :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
  (form-seq (three-forms (symbol-form name) a b)))
(defn call3 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r]
  (form-seq (typed-list-conj [:list [:ref :form/r]] (three-forms (symbol-form name) a b) c)))
(defn call4 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
  (form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (three-forms (symbol-form name) a b) c) d)))
(defn call5 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
  (form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (three-forms (symbol-form name) a b) c) d) e)))
(defn call6 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
  (form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (three-forms (symbol-form name) a b) c) d) e) f)))

(defn vec2 [a [:ref :form/r] b [:ref :form/r]] [:ref :form/r] (form-vec (two-forms a b)))
(defn vec3 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r] (form-vec (three-forms a b c)))
(defn vec4 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
  (form-vec (typed-list-conj [:list [:ref :form/r]] (three-forms a b c) d)))
(defn vec5 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
  (form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (three-forms a b c) d) e)))
(defn vec6 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
  (form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (three-forms a b c) d) e) f)))

;; ---- a bounded :document read into a Form (constant tables written as EDN) ----

(defn- doc-at [d :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at d i) (document-null)))

(defn- doc-list-at [d :document i :i64] :document
  (option-value-of [:option :document] (document-list-at d i) (document-null)))

(defn- doc-entry-at [d :document i :i64] :document
  (option-value-of [:option :document] (document-map-entry-at d i) (document-null)))

(defn- doc-items [d :document list? :bool] [:list [:ref :form/r]]
  (let [n (document-count d)]
    (loop [i 0 acc (no-forms)]
      (if (>= i n)
        acc
        (recur (inc i)
               (typed-list-conj [:list [:ref :form/r]] acc
                                (from-document (if list? (doc-list-at d i) (doc-at d i)))))))))

(defn- doc-map-items [d :document] [:list [:ref :form/r]]
  (let [n (document-count d)]
    (loop [i 0 acc (no-forms)]
      (if (>= i n)
        acc
        (let [e (doc-entry-at d i)]
          (recur (inc i)
                 (typed-list-conj [:list [:ref :form/r]]
                                  (typed-list-conj [:list [:ref :form/r]] acc (from-document (doc-at e 0)))
                                  (from-document (doc-at e 1)))))))))

;; A document can be indexed as a vector, list or map but a SET cannot be
;; enumerated (there is no document-set-nth), so a constant table writes a set as
;; the vector [:kotoba.form/set item ...], which reads as a set form. A document
;; has no float or symbol here: those two kinds read as nil.
(defn- set-marker? [d :document] :bool
  (and (> (document-count d) 0)
       (= (document-kind (doc-at d 0)) :keyword)
       (= (option-value-of [:option :keyword] (document-keyword-value (doc-at d 0)) :none) :kotoba.form/set)))

(defn- doc-set-items [d :document] [:list [:ref :form/r]]
  (let [n (document-count d)]
    (loop [i 1 acc (no-forms)]
      (if (>= i n)
        acc
        (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (from-document (doc-at d i))))))))

(defn from-document [d :document] [:ref :form/r]
  (let [kind (document-kind d)]
    (cond
      (= kind :bool) (bool-form (option-value-of [:option :bool] (document-bool-value d) false))
      (= kind :i64) (int-form (option-value-of [:option :i64] (document-i64-value d) 0))
      (= kind :string) (string-form (option-value-of [:option :string] (document-string-value d) ""))
      (= kind :keyword) (keyword-form (option-value-of [:option :keyword] (document-keyword-value d) :none))
      (= kind :vector) (if (set-marker? d) (form-set (doc-set-items d)) (form-vec (doc-items d false)))
      (= kind :list) (form-seq (doc-items d true))
      (= kind :set) (form-set (doc-items d false))
      (= kind :map) (form-map (doc-map-items d))
      :else (nil-form))))

(defn keyword-has-namespace? [f [:ref :form/r]] :bool
  (and (= 4 (tag-of f))
       (>= (string-find-byte (document-edn-print (document-keyword (record-get [:ref :form/r] f :k))) 47 0) 0)))

;; The keys of a map form, as a set form.
(defn keys-of [m [:ref :form/r]] [:ref :form/r]
  (let [xs (kids-of m)
        n (vector-count xs)]
    (form-set
     (loop [j 0 acc (no-forms)]
       (if (>= j n)
         acc
         (recur (+ j 2) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs j))))))))

(defn dissoc-form
  "Map M without K (as `dissoc` on the host's map)."
  [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
  (let [xs (kids-of m)
        n (vector-count xs)]
    (form-map
     (loop [j 0 acc (no-forms)]
       (if (>= (+ j 1) n)
         acc
         (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
           (recur (+ j 2)
                  (if (eq key k)
                    acc
                    (typed-list-conj [:list [:ref :form/r]]
                                     (typed-list-conj [:list [:ref :form/r]] acc key)
                                     (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))))

(defn append-many [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (let [n (vector-count ys)]
    (loop [i 0 acc xs]
      (if (>= i n) acc (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] ys i)))))))

;; ---- an EDN reader over Form (rd-* are the reader's; edn-form is its entry) ----
;;
;; The forms it reads: nil true false, decimal integers, strings (unescaped by
;; the document reader), :keywords, symbols, lists, vectors, maps, #{sets} and
;; 'quote. A malformed text traps (an out-of-range read) rather than reading as
;; something else.

(defn- rd [f [:ref :form/r] pos :i64] [:ref :form/rd]
  (record-new [:ref :form/rd] f pos))
(defn- rd-form [r [:ref :form/rd]] [:ref :form/r] (record-get [:ref :form/rd] r :form))
(defn- rd-pos [r [:ref :form/rd]] :i64 (record-get [:ref :form/rd] r :pos))

(defn- rd-fail [] :i64 (vector-at (vector-i64) 0))

(defn- rd-width [c :i64] :i64
  (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))

(defn- rd-space? [c :i64] :bool
  (or (= c 32) (= c 10) (= c 13) (= c 9) (= c 44)))

(defn- rd-delimiter? [c :i64] :bool
  (or (rd-space? c) (= c 40) (= c 41) (= c 91) (= c 93) (= c 123) (= c 125) (= c 34) (= c 59)))

(defn- rd-line-end [s :string i :i64 n :i64] :i64
  (loop [i i]
    (if (or (>= i n) (= 10 (string-code-point-at s i))) i (recur (+ i (rd-width (string-code-point-at s i)))))))

(defn- rd-skip [s :string i :i64] :i64
  (let [n (string-byte-length s)]
    (loop [i i]
      (if (>= i n)
        i
        (let [c (string-code-point-at s i)]
          (cond (rd-space? c) (recur (inc i))
                (= c 59) (recur (rd-line-end s i n))
                :else i))))))

(defn- rd-token-end [s :string i :i64 n :i64] :i64
  (loop [i i]
    (if (>= i n)
      i
      (let [c (string-code-point-at s i)]
        (if (rd-delimiter? c) i (recur (+ i (rd-width c))))))))

(defn- rd-digit? [c :i64] :bool (and (>= c 48) (<= c 57)))

;; the decimal value of s[i, e), or a trap when it is not all digits
(defn- rd-decimal [s :string i :i64 e :i64] :i64
  (loop [j i v 0]
    (if (>= j e)
      v
      (let [c (string-code-point-at s j)]
        (if (rd-digit? c) (recur (inc j) (+ (* v 10) (- c 48))) (rd-fail))))))

(defn- rd-number? [s :string i :i64 e :i64] :bool
  (let [c (string-code-point-at s i)]
    (or (rd-digit? c)
        (and (= c 45) (> (- e i) 1) (rd-digit? (string-code-point-at s (inc i)))))))

(defn- rd-atom [s :string i :i64] [:ref :form/rd]
  (let [n (string-byte-length s)
        e (rd-token-end s i n)
        token (string-substring s i e)
        c (string-code-point-at s i)]
    (cond
      (= e i) (rd (nil-form) (rd-fail))
      (= c 58) (rd (keyword-form (keyword-from-string (string-substring s (inc i) e))) e)
      (string=? token "nil") (rd (nil-form) e)
      (string=? token "true") (rd (bool-form true) e)
      (string=? token "false") (rd (bool-form false) e)
      (rd-number? s i e)
      (rd (int-form (if (= c 45) (- 0 (rd-decimal s (inc i) e)) (rd-decimal s i e))) e)
      :else (rd (symbol-form token) e))))

;; the closing quote of the string starting at I (a quote), past backslash escapes
(defn- rd-string-end [s :string i :i64] :i64
  (let [n (string-byte-length s)]
    (loop [j (inc i)]
      (if (>= j n)
        (rd-fail)
        (let [c (string-code-point-at s j)]
          (cond (= c 34) (inc j)
                (= c 92) (recur (+ j 2))
                :else (recur (+ j (rd-width c)))))))))

(defn- rd-string [s :string i :i64] [:ref :form/rd]
  (let [e (rd-string-end s i)
        d (document-edn-read (string-substring s i e))]
    (rd (string-form (option-value-of [:option :string] (document-string-value d) "")) e)))

(defn- rd-items [s :string i :i64 close :i64] [:ref :form/rd]
  (let [n (string-byte-length s)]
    (loop [j (rd-skip s i) acc (no-forms)]
      (if (>= j n)
        (rd (nil-form) (rd-fail))
        (if (= close (string-code-point-at s j))
          (rd (form-vec acc) (inc j))
          (let [r (rd-value s j)]
            (recur (rd-skip s (rd-pos r)) (typed-list-conj [:list [:ref :form/r]] acc (rd-form r)))))))))

(defn- rd-value [s :string i :i64] [:ref :form/rd]
  (let [n (string-byte-length s)
        j (rd-skip s i)]
    (if (>= j n)
      (rd (nil-form) (rd-fail))
      (let [c (string-code-point-at s j)]
        (cond
          (= c 40) (let [r (rd-items s (inc j) 41)] (rd (form-seq (kids-of (rd-form r))) (rd-pos r)))
          (= c 91) (rd-items s (inc j) 93)
          (= c 123) (let [r (rd-items s (inc j) 125)] (rd (form-map (kids-of (rd-form r))) (rd-pos r)))
          (and (= c 35) (< (inc j) n) (= 123 (string-code-point-at s (inc j))))
          (let [r (rd-items s (+ j 2) 125)] (rd (form-set (kids-of (rd-form r))) (rd-pos r)))
          (= c 39) (let [r (rd-value s (inc j))] (rd (call1 "quote" (rd-form r)) (rd-pos r)))
          (= c 34) (rd-string s j)
          :else (rd-atom s j))))))

(defn edn-form
  "The one form in TEXT."
  [text :string] [:ref :form/r]
  (rd-form (rd-value text 0)))
