(ns kotoba.hir
  {:kotoba/export [formats valid? validate!]}
  (:require [kotoba.lang.coll :as set])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
   (defn- form-no-forms [] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]])))

#?(:kotoba
   (defn- form-one-form [a [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a)))

#?(:kotoba
   (defn- form-two-forms [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b)))

#?(:kotoba
   (defn- form-three-forms [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b c)))

#?(:kotoba
   (defn- form-append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-conj [:list [:ref :form/r]] xs x)))

#?(:kotoba
   (defn- form-mk [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]]] [:ref :form/r]
     (record-new [:ref :form/r] t s n k kids 0 (bytes-empty))))

#?(:kotoba
   (defn- form-nil-form [] [:ref :form/r] (form-mk 0 "" 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-bool-form [b :bool] [:ref :form/r] (form-mk 1 "" (if b 1 0) :none (form-no-forms))))

#?(:kotoba
   (defn- form-int-form [n :i64] [:ref :form/r] (form-mk 2 "" n :none (form-no-forms))))

#?(:kotoba
   (defn- form-string-form [s :string] [:ref :form/r] (form-mk 3 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-keyword-form [k :keyword] [:ref :form/r] (form-mk 4 "" 0 k (form-no-forms))))

#?(:kotoba
   (defn- form-symbol-form [s :string] [:ref :form/r] (form-mk 5 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-form-seq [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 6 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-vec [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 7 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-set [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 8 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-map [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 9 "" 0 :none kids)))

#?(:kotoba
   (defn- form-tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag)))

#?(:kotoba
   (defn- form-kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids)))

#?(:kotoba
   (defn- form-int-value [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n)))

#?(:kotoba
   (defn- form-string-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-symbol-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-keyword-value [f [:ref :form/r]] :keyword (record-get [:ref :form/r] f :k)))

#?(:kotoba
   (defn- form-bool-value [f [:ref :form/r]] :bool (= 1 (record-get [:ref :form/r] f :n))))

#?(:kotoba
   (defn- form-is-nil? [f [:ref :form/r]] :bool (= 0 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-bool? [f [:ref :form/r]] :bool (= 1 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-int? [f [:ref :form/r]] :bool (= 2 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-string? [f [:ref :form/r]] :bool (= 3 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-keyword? [f [:ref :form/r]] :bool (= 4 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-symbol? [f [:ref :form/r]] :bool (= 5 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-seq? [f [:ref :form/r]] :bool (= 6 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-vec? [f [:ref :form/r]] :bool (= 7 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-set? [f [:ref :form/r]] :bool (= 8 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-map? [f [:ref :form/r]] :bool (= 9 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-list-like? [f [:ref :form/r]] :bool (or (= 6 (form-tag-of f)) (= 7 (form-tag-of f)))))

#?(:kotoba
   (defn- form-is-true? [f [:ref :form/r]] :bool (and (= 1 (form-tag-of f)) (= 1 (record-get [:ref :form/r] f :n)))))

#?(:kotoba
   (defn- form-count-of [f [:ref :form/r]] :i64 (vector-count (form-kids-of f))))

#?(:kotoba
   (defn- form-nth-of [f [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form-count-of f)))
       (typed-list-nth [:list [:ref :form/r]] (form-kids-of f) i)
       (form-nil-form))))

#?(:kotoba
   (defn- form-first-of [f [:ref :form/r]] [:ref :form/r] (form-nth-of f 0)))

#?(:kotoba
   (defn- form-lookup-from [kids [:list [:ref :form/r]] key [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (vector-count kids)]
       (loop [j i]
         (if (>= (+ j 1) n)
           (form-nil-form)
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
     (form-lookup-from (form-kids-of m) key 0)))

#?(:kotoba
   (defn- form-lookup-has [kids [:list [:ref :form/r]] key [:ref :form/r]] :bool
     (let [n (vector-count kids)]
       (loop [j 0]
         (if (>= (+ j 1) n)
           false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             true
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
     (form-lookup-has (form-kids-of m) key)))

#?(:kotoba
   (defn- form-member? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i))))))))

#?(:kotoba
   (defn- form-ordered-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys i))
               (recur (inc i))
               false)))
         false))))

#?(:kotoba
   (defn- form-set-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-member? ys (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false)))
         false))))

#?(:kotoba
   (defn- form-map-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [j 0]
           (if (>= (+ j 1) n) true
             (let [k (typed-list-nth [:list [:ref :form/r]] xs j)]
               (if (and (form-lookup-has ys k)
                        (form-eq (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)) (form-lookup-from ys k 0)))
                 (recur (+ j 2))
                 false))))
         false))))

#?(:kotoba
   (defn- form-eq
     "Structural equality, as `=` on the host's data: a list and a vector are
     different kinds here (as are they to the reader), sets and maps compare
     without order."
     [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [t (form-tag-of a)]
       (and (= t (form-tag-of b))
            (cond
              (= t 0) true
              (= t 1) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 2) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 3) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 4) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
              (= t 5) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 8) (form-set-eq (form-kids-of a) (form-kids-of b))
              (= t 9) (form-map-eq (form-kids-of a) (form-kids-of b))
              :else (form-ordered-eq (form-kids-of a) (form-kids-of b)))))))



#?(:kotoba
   (defn formats [] [:set :keyword] (typed-set-new [:set :keyword] :kotoba.hir/v2 :kotoba.hir/v3))
   :default
   (def formats #{:kotoba.hir/v2 :kotoba.hir/v3}))



#?(:kotoba
   (defn- module-key? [k :keyword] :bool
     (case k
       :format true :namespace true :schemas true :schema-identities true :entry true
       :exports true :result true :effects true :named-operations true
       :language-profile true :functions true
       false))
   :default
   (def ^:private module-keys
     #{:format :namespace :schemas :schema-identities :entry :exports :result
       :effects :named-operations :language-profile :functions}))



#?(:kotoba
   (defn- required-function-key? [k :keyword] :bool
     (case k :name true :params true :result true :effects true :body true false))
   :default
   (def ^:private required-function-keys
     #{:name :params :result :effects :body}))



#?(:kotoba
   (defn- function-key? [k :keyword] :bool
     (or (required-function-key? k)
         (case k
           :source-name true :param-types true :result-inferred? true :effects-ceiling true
           :closure-param-indexes true :i64-pair-chain-param-indexes true :closure-result? true
           :lazy-thunk? true :loop-helper? true :callable-param-contracts true
           :callable-result-contract true
           false)))
   :default
   (def ^:private function-keys
     (into required-function-keys
           #{:source-name :param-types :result-inferred? :effects-ceiling
             :closure-param-indexes :i64-pair-chain-param-indexes :closure-result?
             :lazy-thunk? :loop-helper? :callable-param-contracts
             :callable-result-contract})))



(def ^:private max-form-depth 256)


(def ^:private max-form-nodes 1000000)



#?(:kotoba
   (defn- reject! [problem :keyword] :i64
     ;; The host's data map carries the offending values; the Kotoba twin carries
     ;; the problem, which is what a caller dispatches on. Every check below
     ;; answers a problem keyword (:ok when none) and only `validate!` aborts, so
     ;; no loop holds an abort before its recur.
     (throw (ex-info "HIR rejected" {:phase :hir-validation :problem problem})))
   :default
   (defn- reject! [problem data]
     (throw (ex-info (str "HIR rejected: " (name problem))
                     (assoc data :phase :hir-validation :problem problem)))))



#?(:kotoba
   (defn- portable-bigint? [f [:ref :form/r]] :bool false)
   :default
   (defn- portable-bigint? [value]
     #?(:clj false
        :cljs (boolean
               (and (some? value)
                    (try (= (.-constructor value) js/BigInt)
                         (catch :default _ false)))))))



#?(:kotoba
   (defn- portable-scalar? [f [:ref :form/r]] :bool (<= (form-tag-of f) 5))
   :default
   (defn- portable-scalar? [value]
     (or (nil? value) (boolean? value) (number? value) (string? value)
         (keyword? value) (symbol? value) (char? value)
         (portable-bigint? value))))



#?(:kotoba
   (defn- nonnegative-integer? [f [:ref :form/r]] :bool (and (form-is-int? f) (>= (form-int-value f) 0)))
   :default
   (defn- nonnegative-integer? [value]
     (and (or (integer? value) (portable-bigint? value))
          #?(:clj (not (neg? value))
             :cljs (if (portable-bigint? value)
                     (not (< value (js/BigInt 0)))
                     (not (neg? value)))))))



#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r] (form-form-get m (form-keyword-form k)))
   :default
   (defn- validate-portable-form!
     "Reject host objects and unbounded nesting in checked expression/type data."
     [form]
     (let [nodes (volatile! 0)]
       (letfn [(walk! [value depth]
                 (vswap! nodes inc)
                 (when (> @nodes max-form-nodes)
                   (reject! :form-node-limit {:limit max-form-nodes}))
                 (when (> depth max-form-depth)
                   (reject! :form-depth-limit {:limit max-form-depth}))
                 (cond
                   (portable-scalar? value) nil
                   (map? value) (doseq [[k v] value]
                                  (walk! k (inc depth))
                                  (walk! v (inc depth)))
                   (or (vector? value) (set? value) (seq? value))
                   (doseq [item value] (walk! item (inc depth)))
                   ;; 2026-09-12, adr-2609111900: the `:default` clause below exists so the
                   ;; Kotoba reader, whose only feature is `:kotoba`, reads this file. A
                   ;; `#?(:clj a :cljs b)` with no matching feature reads as NOTHING, which in a
                   ;; map-value position leaves the map with an odd number of forms, so the whole
                   ;; file was refused at read time ("map literal must contain an even number of
                   ;; forms") -- in a dependency, so every dependant stopped here. With `:default`
                   ;; the reader reads the file and refuses the `:cljs` form by NAME later, in the
                   ;; module that uses it. It changes nothing on clj/cljs: Clojure still picks
                   ;; `:clj`, ClojureScript/nbb still picks `:cljs` (first match).
                   :else (reject! :non-portable-form
                                  {:value-type #?(:clj (class value)
                                                  :cljs (type value)
                                                  :default (type value))})))]
         (walk! form 0)))
     form))

#?(:kotoba
   (defn- fhas? [m [:ref :form/r] k :keyword] :bool (form-form-has? m (form-keyword-form k))))

#?(:kotoba
   ;; Preorder, as the host: count the node, refuse past the node limit, then past
   ;; the depth limit, then the children one level deeper. Answers the running node
   ;; count, or -1 (node limit) / -2 (depth limit).
   (defn- walk-kids [kids [:list [:ref :form/r]] depth :i64 nodes :i64] :i64
     (let [n (vector-count kids)]
       (loop [i 0 nodes nodes]
         (if (>= i n)
           nodes
           (let [r (walk (typed-list-nth [:list [:ref :form/r]] kids i) depth nodes)]
             (if (< r 0) r (recur (inc i) r))))))))

#?(:kotoba
   (defn- walk [f [:ref :form/r] depth :i64 nodes :i64] :i64
     (let [nodes (inc nodes)]
       (if (> nodes max-form-nodes)
         -1
         (if (> depth max-form-depth)
           -2
           (if (portable-scalar? f)
             nodes
             (walk-kids (form-kids-of f) (inc depth) nodes)))))))

#?(:kotoba
   (defn- portable-problem [form [:ref :form/r]] :keyword
     (let [r (walk form 0 0)]
       (cond (= r -1) :form-node-limit
             (= r -2) :form-depth-limit
             :else :ok))))



;; An effect row holds two kinds of member. `[:cap/call id]` is an authority
;; the function exercises. `:abort` is a TRACKED CONTROL EFFECT (kotoba-lang
;; `lang/abort-ability.edn`, slice 1): the function may leave its caller's
;; scope through a typed abort, which the frontend lowers to a `[:result T E]`
;; result before this contract sees the body. The keyword carries no error
;; type on purpose -- E lives in the elaborated `:result`, the row only says
;; that the function aborts. `:state` is the PURE ABILITY state (kotoba-lang
;; `lang/state-ability.edn`, slice 1): the function performs get/put, which a
;; handler written in the language answers; the frontend has already lowered it
;; by state passing, so the keyword is the function's TYPE and no authority.
;; Nothing else is admitted: a keyword that is not one of these two is not a
;; row member, so a misspelling fails closed here rather than reading as an
;; effect nothing enforces.
#?(:kotoba
   (defn- control-effect? [k :keyword] :bool (or (= k :abort) (= k :state)))
   :default
   (def ^:private control-effects
     "The keyword row members: tracked control effects and pure abilities."
     #{:abort :state}))



#?(:kotoba
   (defn- valid-effect? [effect [:ref :form/r]] :bool
     (or (and (form-is-keyword? effect) (control-effect? (form-keyword-value effect)))
         (and (form-is-vec? effect)
              (= 2 (form-count-of effect))
              (form-eq (form-nth-of effect 0) (form-keyword-form :cap/call))
              (nonnegative-integer? (form-nth-of effect 1)))))
   :default
   (defn- valid-effect? [effect]
     (or (contains? control-effects effect)
         (and (vector? effect)
              (= 2 (count effect))
              (= :cap/call (first effect))
              (nonnegative-integer? (second effect))))))



#?(:kotoba
   (defn- all-effects-valid? [effects [:list [:ref :form/r]]] :bool
     (let [n (vector-count effects)]
       (loop [i 0]
         (if (>= i n) true
           (if (valid-effect? (typed-list-nth [:list [:ref :form/r]] effects i)) (recur (inc i)) false)))))
   :default
   (defn- validate-effects! [effects context]
     (when-not (and (set? effects) (every? valid-effect? effects))
       (reject! :invalid-effects (assoc context :effects effects)))))

#?(:kotoba
   (defn- effects-ok? [effects [:ref :form/r]] :bool
     (and (form-is-set? effects) (all-effects-valid? (form-kids-of effects)))))



#?(:kotoba
   (defn- distinct-forms? [xs [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) true
           (if (loop [j (inc i)]
                 (if (>= j n) true
                   (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] xs j))
                     false
                     (recur (inc j)))))
             (recur (inc i))
             false)))))
   :default
   (defn- valid-indexes? [indexes parameter-count]
     (and (vector? indexes)
          (= (count indexes) (count (distinct indexes)))
          (every? #(and (integer? %) (<= 0 %)
                        (< % parameter-count))
                  indexes))))

#?(:kotoba
   (defn- indexes-in-range? [xs [:list [:ref :form/r]] parameter-count :i64] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) true
           (let [x (typed-list-nth [:list [:ref :form/r]] xs i)]
             (if (and (form-is-int? x) (<= 0 (form-int-value x)) (< (form-int-value x) parameter-count))
               (recur (inc i))
               false)))))))

#?(:kotoba
   (defn- valid-indexes? [indexes [:ref :form/r] parameter-count :i64] :bool
     (and (form-is-vec? indexes)
          (distinct-forms? (form-kids-of indexes))
          (indexes-in-range? (form-kids-of indexes) parameter-count))))



#?(:kotoba
   (defn- truthy? [f [:ref :form/r]] :bool
     (not (or (form-is-nil? f) (and (form-is-bool? f) (not (form-bool-value f))))))
   :default
   (defn- validate-function! [format function]
     (when-not (map? function)
       (reject! :function-not-map {:function function}))
     (let [keys* (set (keys function))
           unknown (set/difference keys* function-keys)
           missing (set/difference required-function-keys keys*)
           {:keys [name source-name params param-types effects effects-ceiling body]}
           function]
       (when (seq unknown)
         (reject! :unknown-function-keys {:function name :keys unknown}))
       (when (seq missing)
         (reject! :missing-function-keys {:function name :keys missing}))
       (when-not (symbol? name)
         (reject! :invalid-function-name {:function name}))
       (when-not (or (nil? source-name) (symbol? source-name))
         (reject! :invalid-source-name {:function name :source-name source-name}))
       (when-not (and (vector? params) (every? symbol? params)
                      (= (count params) (count (distinct params))))
         (reject! :invalid-parameters {:function name :params params}))
       (if (= :kotoba.hir/v3 format)
         (when-not (and (vector? param-types)
                        (= (count params) (count param-types)))
           (reject! :invalid-parameter-types
                    {:function name :params params :param-types param-types}))
         (when (contains? function :param-types)
           (reject! :v2-parameter-types {:function name})))
       (validate-effects! effects {:function name})
       (when (contains? function :effects-ceiling)
         (validate-effects! effects-ceiling {:function name :field :effects-ceiling})
         (when-not (set/subset? effects effects-ceiling)
           (reject! :effect-ceiling-exceeded
                    {:function name :effects effects :ceiling effects-ceiling})))
       (doseq [field [:closure-param-indexes :i64-pair-chain-param-indexes]
               :when (contains? function field)]
         (when-not (valid-indexes? (get function field) (count params))
           (reject! :invalid-parameter-indexes
                    {:function name :field field :indexes (get function field)})))
       (doseq [field [:closure-result? :lazy-thunk? :loop-helper?]
               :when (contains? function field)]
         (when-not (boolean? (get function field))
           (reject! :invalid-boolean-annotation
                    {:function name :field field :value (get function field)})))
       (when (contains? function :result-inferred?)
         (when-not (or (nil? (:result-inferred? function))
                       (boolean? (:result-inferred? function)))
           (reject! :invalid-result-inferred {:function name})))
       (when (contains? function :callable-param-contracts)
         (let [contracts (:callable-param-contracts function)]
           (when-not (and (map? contracts)
                          (every? #(and (integer? %) (<= 0 %) (< % (count params)))
                                  (keys contracts)))
             (reject! :invalid-callable-parameter-contracts
                      {:function name :contracts contracts}))))
       (when (nil? body)
         (reject! :missing-function-body {:function name}))
       (validate-portable-form! (:result function))
       (when param-types (validate-portable-form! param-types))
       (when-let [contract (:callable-result-contract function)]
         (validate-portable-form! contract))
       (when-let [contracts (:callable-param-contracts function)]
         (validate-portable-form! contracts))
       (validate-portable-form! body))
     function))

#?(:kotoba
   (defn- all-symbols? [xs [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) true
           (if (form-is-symbol? (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false))))))

#?(:kotoba
   ;; kind 0: function keys, kind 1: module keys. A key that is not a keyword is
   ;; unknown.
   (defn- keys-known? [m [:ref :form/r] kind :i64] :bool
     (let [kids (form-kids-of m)
           n (vector-count kids)]
       (loop [j 0]
         (if (>= j n) true
           (let [k (typed-list-nth [:list [:ref :form/r]] kids j)]
             (if (and (form-is-keyword? k)
                      (if (= kind 0) (function-key? (form-keyword-value k)) (module-key? (form-keyword-value k))))
               (recur (+ j 2))
               false)))))))

#?(:kotoba
   (defn- required-present? [m [:ref :form/r]] :bool
     (and (fhas? m :name) (fhas? m :params) (fhas? m :result) (fhas? m :effects) (fhas? m :body))))

#?(:kotoba
   (defn- subset-of? [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs) c (vector-count ys)]
       (loop [i 0]
         (if (>= i n) true
           (if (loop [j 0]
                 (if (>= j c) false
                   (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys j)) true (recur (inc j)))))
             (recur (inc i))
             false))))))

#?(:kotoba
   (defn- contracts-keys-ok? [m [:ref :form/r] parameter-count :i64] :bool
     (let [kids (form-kids-of m)
           n (vector-count kids)]
       (loop [j 0]
         (if (>= j n) true
           (let [k (typed-list-nth [:list [:ref :form/r]] kids j)]
             (if (and (form-is-int? k) (<= 0 (form-int-value k)) (< (form-int-value k) parameter-count))
               (recur (+ j 2))
               false)))))))

#?(:kotoba
   (defn- index-field-bad? [function [:ref :form/r] field :keyword parameter-count :i64] :bool
     (and (fhas? function field) (not (valid-indexes? (fget function field) parameter-count)))))

#?(:kotoba
   (defn- boolean-field-bad? [function [:ref :form/r] field :keyword] :bool
     (and (fhas? function field) (not (form-is-bool? (fget function field))))))

#?(:kotoba
   (defn- portable-or [problem :keyword form [:ref :form/r]] :keyword
     (if (= problem :ok) (portable-problem form) problem)))

#?(:kotoba
   ;; The first problem in the host's check order, or :ok.
   (defn- function-problem [format [:ref :form/r] function [:ref :form/r]] :keyword
     (let [name (fget function :name)
           source-name (fget function :source-name)
           params (fget function :params)
           param-types (fget function :param-types)
           effects (fget function :effects)
           ceiling (fget function :effects-ceiling)
           pc (form-count-of params)
           v3 (form-eq format (form-keyword-form :kotoba.hir/v3))
           contracts (fget function :callable-param-contracts)
           result-inferred (fget function :result-inferred?)]
       (cond
         (not (form-is-map? function)) :function-not-map
         (not (keys-known? function 0)) :unknown-function-keys
         (not (required-present? function)) :missing-function-keys
         (not (form-is-symbol? name)) :invalid-function-name
         (not (or (form-is-nil? source-name) (form-is-symbol? source-name))) :invalid-source-name
         (not (and (form-is-vec? params) (all-symbols? (form-kids-of params))
                   (distinct-forms? (form-kids-of params)))) :invalid-parameters
         (and v3 (not (and (form-is-vec? param-types) (= pc (form-count-of param-types))))) :invalid-parameter-types
         (and (not v3) (fhas? function :param-types)) :v2-parameter-types
         (not (effects-ok? effects)) :invalid-effects
         (and (fhas? function :effects-ceiling) (not (effects-ok? ceiling))) :invalid-effects
         (and (fhas? function :effects-ceiling)
              (not (subset-of? (form-kids-of effects) (form-kids-of ceiling)))) :effect-ceiling-exceeded
         (index-field-bad? function :closure-param-indexes pc) :invalid-parameter-indexes
         (index-field-bad? function :i64-pair-chain-param-indexes pc) :invalid-parameter-indexes
         (boolean-field-bad? function :closure-result?) :invalid-boolean-annotation
         (boolean-field-bad? function :lazy-thunk?) :invalid-boolean-annotation
         (boolean-field-bad? function :loop-helper?) :invalid-boolean-annotation
         (and (fhas? function :result-inferred?)
              (not (or (form-is-nil? result-inferred) (form-is-bool? result-inferred)))) :invalid-result-inferred
         (and (fhas? function :callable-param-contracts)
              (not (and (form-is-map? contracts) (contracts-keys-ok? contracts pc)))) :invalid-callable-parameter-contracts
         (form-is-nil? (fget function :body)) :missing-function-body
         :else
         (let [p1 (portable-problem (fget function :result))
               p2 (if (and (= p1 :ok) (truthy? param-types)) (portable-problem param-types) p1)
               p3 (if (and (= p2 :ok) (truthy? (fget function :callable-result-contract)))
                    (portable-problem (fget function :callable-result-contract)) p2)
               p4 (if (and (= p3 :ok) (truthy? contracts)) (portable-problem contracts) p3)]
           (if (= p4 :ok) (portable-problem (fget function :body)) p4))))))



#?(:kotoba
   (defn- functions-problem [format [:ref :form/r] functions [:list [:ref :form/r]]] :keyword
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n) :ok
           (let [p (function-problem format (typed-list-nth [:list [:ref :form/r]] functions i))]
             (if (= p :ok) (recur (inc i)) p))))))
   :default
   (defn validate!
     "Validate the checked HIR module envelope and return it unchanged.

     This validates the inter-repository contract, not source semantics: sema is
     responsible for proving that admitted expression operations are well typed."
     [hir]
     (when-not (map? hir)
       (reject! :module-not-map {:hir hir}))
     (let [keys* (set (keys hir))
           unknown (set/difference keys* module-keys)
           missing (set/difference module-keys keys*)
           {:keys [format namespace schemas schema-identities entry exports result
                   effects named-operations language-profile functions]} hir]
       (when (seq unknown) (reject! :unknown-module-keys {:keys unknown}))
       (when (seq missing) (reject! :missing-module-keys {:keys missing}))
       (when-not (contains? formats format)
         (reject! :unsupported-format {:format format}))
       (when-not (or (nil? namespace) (symbol? namespace))
         (reject! :invalid-namespace {:namespace namespace}))
       (when-not (or (nil? schemas) (map? schemas))
         (reject! :invalid-schemas {:schemas schemas}))
       (when-not (or (nil? schema-identities) (map? schema-identities))
         (reject! :invalid-schema-identities {:schema-identities schema-identities}))
       (when-not (or (nil? language-profile) (keyword? language-profile))
         (reject! :invalid-language-profile {:language-profile language-profile}))
       (when-not (and (vector? functions) (seq functions))
         (reject! :invalid-functions {:functions functions}))
       (doseq [function functions] (validate-function! format function))
       (let [names (mapv :name functions)
             name-set (set names)
             by-name (into {} (map (juxt :name identity)) functions)]
         (when-not (= (count names) (count name-set))
           (reject! :duplicate-function-names {:names names}))
         (when-not (and (vector? exports) (every? symbol? exports)
                        (= (count exports) (count (distinct exports)))
                        (set/subset? (set exports) name-set))
           (reject! :invalid-exports {:exports exports :functions name-set}))
         (when-not (or (nil? entry) (and (symbol? entry) (contains? name-set entry)
                                         (some #{entry} exports)))
           (reject! :invalid-entry {:entry entry :exports exports}))
         (if entry
           (when-not (= result (:result (get by-name entry)))
             (reject! :entry-result-mismatch
                      {:entry entry :result result
                       :function-result (:result (get by-name entry))}))
           (when (some? result)
             (reject! :entryless-result {:result result}))))
       (validate-effects! effects {:scope :module})
       (let [inferred (reduce set/union #{} (map :effects functions))]
         (when-not (= effects inferred)
           (reject! :module-effects-mismatch
                    {:effects effects :function-effects inferred})))
       (when-not (and (set? named-operations) (every? keyword? named-operations))
         (reject! :invalid-named-operations {:named-operations named-operations}))
       (validate-portable-form! schemas)
       (validate-portable-form! schema-identities))
     hir))

#?(:kotoba
   (defn- function-names [functions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count functions)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) acc
           (recur (inc i) (form-append-form acc (fget (typed-list-nth [:list [:ref :form/r]] functions i) :name))))))))

#?(:kotoba
   (defn- function-named [functions [:list [:ref :form/r]] name [:ref :form/r]] [:ref :form/r]
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n) (form-nil-form)
           (let [f (typed-list-nth [:list [:ref :form/r]] functions i)]
             (if (form-eq (fget f :name) name) f (recur (inc i)))))))))

#?(:kotoba
   ;; The union of the functions' effect sets, first occurrence kept.
   (defn- union-effects [functions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count functions)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) acc
           (let [es (form-kids-of (fget (typed-list-nth [:list [:ref :form/r]] functions i) :effects))
                 m (vector-count es)]
             (recur (inc i)
                    (loop [j 0 acc acc]
                      (if (>= j m) acc
                        (let [e (typed-list-nth [:list [:ref :form/r]] es j)]
                          (recur (inc j)
                                 (if (subset-of? (form-one-form e) acc) acc (form-append-form acc e)))))))))))))

#?(:kotoba
   (defn- all-keywords? [xs [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) true
           (if (form-is-keyword? (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false))))))

#?(:kotoba
   (defn- member-form? [x [:ref :form/r] xs [:list [:ref :form/r]]] :bool (subset-of? (form-one-form x) xs)))

#?(:kotoba
   (defn- format-known? [f [:ref :form/r]] :bool
     (or (form-eq f (form-keyword-form :kotoba.hir/v2)) (form-eq f (form-keyword-form :kotoba.hir/v3)))))

#?(:kotoba
   (defn- module-problem [hir [:ref :form/r]] :keyword
     (let [format (fget hir :format)
           namespace (fget hir :namespace)
           schemas (fget hir :schemas)
           schema-identities (fget hir :schema-identities)
           entry (fget hir :entry)
           exports (fget hir :exports)
           result (fget hir :result)
           effects (fget hir :effects)
           named-operations (fget hir :named-operations)
           language-profile (fget hir :language-profile)
           functions (fget hir :functions)
           names (function-names (form-kids-of functions))
           fp (functions-problem format (form-kids-of functions))
           inferred (union-effects (form-kids-of functions))]
       (cond
         (not (form-is-map? hir)) :module-not-map
         (not (keys-known? hir 1)) :unknown-module-keys
         (not (and (fhas? hir :format) (fhas? hir :namespace) (fhas? hir :schemas)
                   (fhas? hir :schema-identities) (fhas? hir :entry) (fhas? hir :exports)
                   (fhas? hir :result) (fhas? hir :effects) (fhas? hir :named-operations)
                   (fhas? hir :language-profile) (fhas? hir :functions))) :missing-module-keys
         (not (format-known? format)) :unsupported-format
         (not (or (form-is-nil? namespace) (form-is-symbol? namespace))) :invalid-namespace
         (not (or (form-is-nil? schemas) (form-is-map? schemas))) :invalid-schemas
         (not (or (form-is-nil? schema-identities) (form-is-map? schema-identities))) :invalid-schema-identities
         (not (or (form-is-nil? language-profile) (form-is-keyword? language-profile))) :invalid-language-profile
         (not (and (form-is-vec? functions) (> (form-count-of functions) 0))) :invalid-functions
         (not (= fp :ok)) fp
         (not (distinct-forms? names)) :duplicate-function-names
         (not (and (form-is-vec? exports) (all-symbols? (form-kids-of exports))
                   (distinct-forms? (form-kids-of exports))
                   (subset-of? (form-kids-of exports) names))) :invalid-exports
         (not (or (form-is-nil? entry)
                  (and (form-is-symbol? entry) (member-form? entry names)
                       (member-form? entry (form-kids-of exports))))) :invalid-entry
         (and (not (form-is-nil? entry))
              (not (form-eq result (fget (function-named (form-kids-of functions) entry) :result)))) :entry-result-mismatch
         (and (form-is-nil? entry) (not (form-is-nil? result))) :entryless-result
         (not (effects-ok? effects)) :invalid-effects
         (not (and (subset-of? (form-kids-of effects) inferred)
                   (subset-of? inferred (form-kids-of effects)))) :module-effects-mismatch
         (not (and (form-is-set? named-operations) (all-keywords? (form-kids-of named-operations)))) :invalid-named-operations
         (not (= (portable-problem schemas) :ok)) (portable-problem schemas)
         :else (portable-problem schema-identities)))))

#?(:kotoba
   (defn validate!
     "Validate the checked HIR module envelope and return it unchanged. The
     Kotoba twin reads the module as a `kotoba.form` value and aborts with the
     problem (the host's data map also carries the offending values)."
     [hir [:ref :form/r]] [:ref :form/r]
     (let [p (module-problem hir)]
       (if (= p :ok) hir (do (reject! p) hir)))))



#?(:kotoba
   (defn valid? [hir [:ref :form/r]] :bool
     (= :ok (module-problem hir)))
   :default
   (defn valid? [hir]
     (try
       (validate! hir)
       true
       (catch #?(:clj Exception :cljs :default) _ false))))
